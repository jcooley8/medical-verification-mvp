# Medical Verification MVP - Backend Configuration
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/medical_verification
# For local development with SQLite:
# DATABASE_URL=sqlite:///./medical_verification.db

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Upload Configuration
UPLOAD_DIR=/code/uploads
MAX_FILE_SIZE_MB=50

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# LLM Service Configuration (for future use)
# ANTHROPIC_API_KEY=your_api_key_here
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_MAX_TOKENS=4096

# Logging Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Application Settings
APP_NAME="Medical Verification MVP"
APP_VERSION="1.0.0"
